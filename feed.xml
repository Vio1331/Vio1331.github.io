---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | xml_escape }}">
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.author.name | xml_escape }}</name></author>
  {% assign journal_entries = site.journal | sort: 'date' | reverse %}
  {% for entry in journal_entries limit: 10 %}
  <entry>
    <title type="html">{{ entry.title | xml_escape }}</title>
    <link href="{{ entry.url | absolute_url | xml_escape }}" rel="alternate" type="text/html" title="{{ entry.title | xml_escape }}"/>
    <id>{{ entry.journal_feed_id | absolute_url | xml_escape }}</id>
    <published>{{ entry.date | date_to_xmlschema }}</published>
    <updated>{{ entry.last_modified_at | default: entry.date | date_to_xmlschema }}</updated>
    {% if entry.category %}<category term="{{ entry.category | xml_escape }}"/>{% endif %}
    {% if entry.excerpt_text %}<summary type="html">{{ entry.excerpt_text | xml_escape }}</summary>{% endif %}
    <content type="html" xml:base="{{ entry.url | absolute_url | xml_escape }}">{{ entry.content | content_image_paths: entry.image_base | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
